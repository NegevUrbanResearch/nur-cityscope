# Database (Postgres container + Django)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=nur_db
DATABASE_URL=postgres://postgres:your_secure_password@db:5432/nur_db

# Ports (host mapping; API internal port is 9900)
API_PORT=9900
FRONT_PORT=80

# Mapbox (required for dashboard maps; get token at https://account.mapbox.com/)
REACT_APP_MAPBOX_ACCESS_TOKEN=your-mapbox-token
